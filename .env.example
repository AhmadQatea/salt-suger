APP_NAME="Salt&Suger"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public base URL used for absolute links, canonical URLs, and the menu QR code.
# Local development example: http://localhost (or http://127.0.0.1:8000)
# Production / Laravel Cloud example: https://your-app.laravel.cloud
# Never hardcode localhost in application code — configure APP_URL per environment.
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salt_suger
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Local defaults. On Laravel Cloud prefer redis for sessions + cache.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Laravel Cloud Build Commands:
#   composer install --no-dev --optimize-autoloader --no-interaction
#   npm ci && npm run build
#   php artisan optimize
#
# Laravel Cloud Deploy Commands:
#   php artisan migrate --force
#   php artisan storage:link
#
# Prefer Redis/Valkey for CACHE_STORE + SESSION_DRIVER in production.
# Laravel Cloud: attach a public Object Storage bucket, then add AWS_URL manually
# (bucket settings page → copy public URL → Environment → custom variable).
# Example: AWS_URL=https://your-bucket.r2.dev
